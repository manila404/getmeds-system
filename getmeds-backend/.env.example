PORT=4000
NODE_ENV=development
JWT_SECRET=getmeds_dev_secret_change_in_production
DEBUG=false
TEST_MODE=false

# Zoho Integration
# ZOHO_MODE controls which adapter src/integrations/zoho/index.js builds:
#   mock       (default/safe) — pure in-memory, zero network calls. Use this
#              for all day-to-day dev and for demos.
#   http-mock  — real HTTP calls, but pointed at the local mock-server/
#              (`npm run mock-server`, defaults to http://127.0.0.1:4100).
#              Proves the live HTTP/OAuth code path works with zero risk.
#   live       — real HTTP calls against a real Zoho organization. Requires
#              ZOHO_ORG_ID to be listed in ZOHO_ALLOWED_ORG_IDS below, or the
#              app refuses to start (fail-closed). Only ever point this at
#              an isolated test/sandbox Zoho org, never the production one,
#              until the company has explicitly signed off.
ZOHO_MODE=mock
ZOHO_API_BASE_URL=
# Get credentials from: https://api-console.zoho.com/ — scope them to your
# test/sandbox organization's ID only.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# Comma-separated allowlist of organization_ids ZOHO_MODE=live is permitted
# to use. Leave blank to make "live" mode refuse to start entirely.
ZOHO_ALLOWED_ORG_IDS=

# Google Chat Webhook — leave blank to only log payloads (no real HTTP call)
# Create webhook at: https://chat.google.com → Space Settings → Integrations → Webhooks
GOOGLE_CHAT_WEBHOOK_URL=

# SMTP — leave SMTP_HOST blank to only log email payloads (no real send).
# Any standard SMTP provider works (Gmail/Workspace app password, SendGrid,
# Mailgun, Amazon SES, etc). A send failure is logged, never thrown — email
# is a notification channel, never the system of record.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Getmeds Orders <no-reply@getmeds.ph>"

# Zoho sync retry/outbox — how the background job retries a failed Zoho
# Sales Order sync (see src/services/zohoRetryService.js). Defaults shown.
ZOHO_RETRY_INTERVAL_MS=30000
ZOHO_RETRY_MAX_ATTEMPTS=5
ZOHO_RETRY_BASE_DELAY_MS=30000
ZOHO_RETRY_MAX_DELAY_MS=1800000

# Zoho auto-sync (Sep 1, 2026) — the PULL half, opposite the retry loop above.
# Reconciles open orders against Zoho on a schedule so the audit trail fills
# itself in when a webhook never arrives (a Workflow Rule that isn't built
# yet, or the tunnel to this machine being down). See
# src/services/zohoAutoSyncService.js. Defaults shown; ON by default.
#
# Each tick costs one Zoho API read per order, so BATCH x (3600/interval) is
# the worst-case hourly read count — 20 every 5 min is ~240 reads/hour.
# Set ZOHO_AUTO_SYNC_ENABLED=false to stop background polling entirely;
# opening an order still refreshes it, which costs nothing while nobody is
# looking.
ZOHO_AUTO_SYNC_ENABLED=true
ZOHO_AUTO_SYNC_INTERVAL_MS=300000
ZOHO_AUTO_SYNC_BATCH=20
# Cooldown before opening the same order pulls from Zoho again. The frontend
# re-fetches on a timer, so without this one open tab is a continuous stream
# of reads for a single order.
ZOHO_AUTO_SYNC_OPEN_COOLDOWN_MS=60000
# Spacing between orders within a tick, so a batch trickles rather than
# hitting Zoho's rate limiter with 20 simultaneous requests.
ZOHO_AUTO_SYNC_STAGGER_MS=400
# How long GET /api/orders/:id waits on Zoho before serving the order as-is.
# Short on purpose — this is a page load, and the poller catches what it misses.
ZOHO_OPEN_REFRESH_TIMEOUT_MS=4000

# Webhook receiver — Zoho -> Getmeds (POST /api/webhooks/zoho, see
# src/controllers/webhook.controller.js). Leave blank in development to
# accept any incoming webhook unauthenticated. Set this before pointing a
# real Zoho webhook at the endpoint, and paste the same value into Zoho's
# webhook custom header (X-Zoho-Webhook-Token) or as ?token=... in the URL.
ZOHO_WEBHOOK_SECRET=

# ── Accounts ──────────────────────────────────────────────────────────────
# Sep 11, 2026: there is no self-service sign-up. POST /api/auth/register and
# its SIGNUP_* settings are gone; every account is created by an admin on
# /admin/users (POST /api/admin/users) and handed to the person. An existing
# .env that still sets SIGNUP_ENABLED, SIGNUP_ALLOWED_EMAIL_DOMAINS,
# SIGNUP_RATE_MAX or SIGNUP_RATE_WINDOW_MS is harmless — nothing reads them.

# ── Zoho network resilience (Sep 2, 2026) ────────────────────────────────
# Added after a Full Resync died with Node's famously unhelpful
# "TypeError: fetch failed". Two separate problems, both fixed in
# src/integrations/zoho/LiveZohoAdapter.js:
#
#  1. The message. undici reports every transport failure — DNS, TLS,
#     refused, timeout, proxy — with those same three words and puts the
#     real reason on err.cause. The adapter now unwraps it, so the job
#     error names ENOTFOUND / ECONNRESET / ConnectTimeoutError and what
#     each one usually means.
#  2. The fragility. A Full Resync is ~475 sequential page reads; one blip
#     anywhere aborted the whole job and discarded every page already
#     fetched. GETs are now retried with backoff.
#
# Retries are GET-ONLY, deliberately. createSalesOrder is the only POST
# this app makes and a network error says nothing about whether Zoho
# received it — retrying could create a SECOND real Sales Order. A failed
# create goes to the zoho_sync_queue outbox instead.
ZOHO_REQUEST_TIMEOUT_MS=30000
ZOHO_REQUEST_RETRIES=3
ZOHO_REQUEST_RETRY_BASE_MS=800

# ── Zoho Sales Order import (Sep 9, 2026) ────────────────────────────────
# "Retrieve All Sales Orders" on the Management Dashboard — pulls Sales
# Orders that exist in Zoho into this app, including the ones raised
# directly in Zoho, and rebuilds each order's trail from Zoho's own record
# (its current state, plus its Comments & History log). Read-only towards
# Zoho: three GETs, no write of any kind.
# See src/services/zohoOrderImportService.js.
#
# The import has TWO tiers, and this caps only the expensive one.
#
#  Tier 1 — every Sales Order in the org is adopted from Zoho's LIST
#           response (one call per 200 orders). That response carries the
#           number, customer, total, date, salesperson and status, which is
#           enough for a real order row. So a full run shows ALL of them,
#           however many there are, and this setting does not limit it.
#  Tier 2 — line items and Zoho's Comments & History need a GET per order,
#           two calls each. At this org's 65,000+ Sales Orders that is
#           ~130,000 calls against an API with a per-minute rate limit and a
#           daily budget, so it cannot be one click. This is that budget per
#           run; the rest is filled in by running the import again, and on
#           demand whenever somebody opens an order.
#
# An order whose detail has not been pulled yet is not broken — it is
# summary-only, tracked by orders.zoho_detail_synced_at being NULL.
ZOHO_SO_IMPORT_MAX=500

# How many orders are fetched from Zoho at once. Roughly double this many
# requests are in flight (detail + comments per order), so keep it well
# under the per-minute rate limit.
ZOHO_SO_IMPORT_CONCURRENCY=3

# Zoho reports a history entry's timestamp as a local date plus a local
# clock time, with the org's timezone implied and never stated in the
# payload. order_events.created_at is UTC, so the two have to be
# reconciled. +08:00 because this org is Philippine (Asia/Manila has no
# DST, so a fixed offset is exact). The raw date/time strings are kept
# verbatim in each event's metadata regardless, so a wrong value here
# misorders the trail but never loses anything.
ZOHO_ORG_UTC_OFFSET=+08:00

{
  "name": "getmeds-backend",
  "version": "1.0.0",
  "description": "Getmeds Order Process Automation System Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:test": "nodemon server.js --test",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "test": "jest",
    "reset:orders": "node scripts/reset-orders.js",
    "fresh:start": "node scripts/fresh-start.js",
    "backup": "node scripts/backup-db.js",
    "secrets:init": "node scripts/set-secrets.js",
    "check:zoho": "node scripts/check-zoho.js",
    "check:salespersons": "node scripts/check-salespersons.js",
    "mock-server": "node mock-server/server.js",
    "simulate:webhook": "node scripts/simulate-zoho-webhook.js",
    "migrate:pg": "node src/db/migrate.pg.js",
    "portcheck": "node scripts/portcheck.js src",
    "verify:pg": "node tests/pgLayer.verify.js",
    "create:user": "node scripts/create-user.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jscodeshift": "^17.4.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}

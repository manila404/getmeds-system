{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ],
  "crons": [
    { "path": "/api/cron/auto-sync", "schedule": "0 1 * * *" },
    { "path": "/api/cron/zoho-retry", "schedule": "30 1 * * *" }
  ]
}
